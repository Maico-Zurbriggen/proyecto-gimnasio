VITE_API_URL=http://localhost:3000

# Identidades de desarrollo mientras el backend no tenga login. Se envían como
# headers x-user-id / x-user-roles / x-gym-id (auth.middleware del backend),
# una por rol. Nunca configurarlas en un deployment. Valores cargados en
# Neon Test por seed-demo.sql: Alumno Demo (rutina VIGENTE) y Entrenador Demo.
# El seed demo no crea administrador.
VITE_DEV_STUDENT_ID=20000000-0000-4000-8000-000000000002
VITE_DEV_TRAINER_ID=20000000-0000-4000-8000-000000000003
VITE_DEV_ADMIN_ID=
VITE_DEV_GYM_ID=20000000-0000-4000-8000-000000000001
